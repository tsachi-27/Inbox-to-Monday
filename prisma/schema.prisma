// Prisma schema for ati-lead-sync.
//
// Why Postgres and not a local file: Vercel's serverless functions run on a
// read-only filesystem (only /tmp is writable, and it's wiped between
// invocations and not shared across instances), so dedup state can't live
// in a JSON file the way the original local script did. Postgres persists
// identically across every invocation. This is its own database, separate
// from ati-reviews' — no shared data between the two unrelated projects.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per Gmail message we've evaluated, keyed by Gmail's message id.
// This is the entire dedup mechanism — before processing a message, check
// whether its id is already here; after processing, record it here.
model ProcessedMessage {
  messageId   String   @id
  source      String // "ati-lead" | "ati-propel-contact"
  status      String // "created" | "needs_review" | "error"
  itemId      String? // Monday.com item id, when status is "created"
  reason      String? // parse failure reason, when status is "needs_review"
  processedAt DateTime @default(now())
}

// One row per sales order line, imported from the monthly Priority ERP
// export (an .xlsx dropped in a local folder, parsed by
// scripts/import-sales-report.mts). Keyed by the Order # (Priority's own
// SO number, e.g. "SO26000101") so re-importing the same month's file is
// an upsert, not a duplicate insert.
model SalesRecord {
  orderNo       String   @id
  customerNo    String
  customerName  String
  date          DateTime
  orderBookRef  String?
  quoteNo       String?
  details       String?
  totalPrice    Float // מחיר כולל - excl. VAT
  vat           Float
  totalWithVat  Float
  currency      String
  cost          Float
  profit        Float
  profitPercent Float
  sourceMonth   String // "YYYY-MM", from the report filename
  importedAt    DateTime @default(now())
}

// One row per email Claude Code sends on Tsachi's behalf to a specific
// lead, for the /SentEmailsCC monitoring page. Written by
// sendLeadEmailAndLog regardless of whether the send succeeded, so failures
// are visible too, not just successes.
model SentEmail {
  id        String   @id @default(cuid())
  sentAt    DateTime @default(now())
  leadName  String
  groupName String
  toEmail   String
  subject   String
  message   String
  status    String // "sent" | "failed"
  error     String? // set when status is "failed"
}
