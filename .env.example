# Copy this file to .env (for local development) and fill in real values.
# On Vercel, add each of these under Project Settings -> Environment Variables instead.
# Never commit your real .env file - it's already in .gitignore.


# ---------------------------------------------------------------------------
# DATABASE_URL
# ---------------------------------------------------------------------------
# A Postgres connection string, used only to track which Gmail messages have
# already been pushed to Monday.com (dedup). This is a separate database
# from any other project - don't reuse ati-reviews' DATABASE_URL here.
#
# Easiest way to get one (free, no credit card needed for the free tier):
#   1. Go to https://neon.tech (or use Vercel's own "Storage" tab -> Postgres,
#      which is Neon under the hood) and create a new project/database.
#   2. Copy the connection string it gives you (it looks like the example
#      below) and paste it here.
#   3. Run `npx prisma migrate deploy` once to create the database table.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"


# ---------------------------------------------------------------------------
# MONDAY_API_TOKEN
# ---------------------------------------------------------------------------
# Your personal Monday.com API token, used to create items on the Leads
# board. Get it from Monday -> your avatar -> Developer -> "API token" (or
# https://<your-account>.monday.com/apps/manage/api). Keep this secret - it
# grants full access to everything your Monday account can do.
MONDAY_API_TOKEN="replace-this-with-your-monday-api-token"


# ---------------------------------------------------------------------------
# GMAIL_IMAP_USER / GMAIL_IMAP_PASSWORD
# ---------------------------------------------------------------------------
# Read-only-in-practice IMAP access to the pro@propel.pro inbox (this app
# only ever reads/searches, never modifies or deletes anything there).
#
# GMAIL_IMAP_USER is just the full email address: pro@propel.pro
#
# GMAIL_IMAP_PASSWORD must be a Gmail "App Password", NOT the real account
# password (Google blocks plain-password IMAP login for security). To get one:
#   1. The account needs 2-Step Verification turned on first:
#      https://myaccount.google.com/security -> 2-Step Verification.
#   2. Then go to https://myaccount.google.com/apppasswords, create a new
#      app password (any name, e.g. "ati-lead-sync"), and copy the 16-character
#      code it shows you (spaces don't matter, with or without is fine).
GMAIL_IMAP_USER="pro@propel.pro"
GMAIL_IMAP_PASSWORD="replace-this-with-a-16-character-app-password"


# ---------------------------------------------------------------------------
# CRON_SECRET
# ---------------------------------------------------------------------------
# Protects the /api/cron/import-leads endpoint so random internet traffic
# can't trigger it (which would burn Gmail/Monday API quota). Unlike a
# Vercel-native cron route, nothing sends this automatically - the GitHub
# Actions workflow in .github/workflows/import-leads.yml sends it explicitly
# as "Authorization: Bearer <CRON_SECRET>", using the SAME value stored as a
# GitHub Actions repo secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace-this-with-a-long-random-string"


# ---------------------------------------------------------------------------
# DASHBOARD_PASSWORD
# ---------------------------------------------------------------------------
# Shared password gating /dashboard and /api/dashboard/* (plain HTTP Basic
# Auth - the browser's own login prompt, username is ignored). Leave unset
# to leave the dashboard open with no password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64').replace(/[+/=]/g,''))"
DASHBOARD_PASSWORD="replace-this-with-a-shared-password"
